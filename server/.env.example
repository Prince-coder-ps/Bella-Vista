# Server
NODE_ENV=development
PORT=5000

# MongoDB — use MongoDB Atlas (free tier) or a local instance
MONGO_URI=mongodb://127.0.0.1:27017/bella-vista

# Client origin(s) for CORS (comma-separate multiple). REQUIRED in production.
CLIENT_URL=http://localhost:5173

# Set to 1 when running behind a reverse proxy / PaaS (Render, Heroku, Nginx...)
# so rate limiting sees real client IPs and secure cookies work.
# TRUST_PROXY=1

# JWT — the server REFUSES TO START if these are missing, placeholders,
# shorter than 32 chars, or identical to each other. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Seed admin account (used by `npm run seed`).
# In production the seed refuses weak/default passwords (12+ chars required).
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@bellavista.com
ADMIN_PASSWORD=Admin@1234

# Demo customer (development only — skipped when NODE_ENV=production)
CUSTOMER_NAME=Guest Diner
CUSTOMER_EMAIL=guest@bellavista.com
CUSTOMER_PASSWORD=Guest@1234
